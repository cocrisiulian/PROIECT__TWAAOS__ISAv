# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/events_db

# Application
API_PREFIX=/api/v1
PROJECT_NAME=Sistem de Management al Evenimentelor Universitare USV

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_ENV=development
FORCE_HTTPS_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30
EXPOSE_RESET_TOKEN_FOR_TESTING=false

# Google OAuth (for student authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# File Upload
UPLOAD_DIR=./uploads

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# Email Configuration (SMTP)
# Set ENABLE_EMAIL=true and configure SMTP to send emails
# For detailed configuration examples, see docs/EMAIL_CONFIGURATION.md

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email Sender Information
SMTP_FROM_EMAIL=noreply@events.usv.ro
SMTP_FROM_NAME=USV Events

# Email Feature Toggle
# Set to true when SMTP is properly configured
ENABLE_EMAIL=false
